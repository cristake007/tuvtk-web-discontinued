# Project
COMPOSE_PROJECT_NAME=tuvtk_web

# Containers
BACKEND_CONTAINER_NAME=tuvtk_backend
POSTGRES_CONTAINER_NAME=tuvtk_postgres

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# Backend
BACKEND_PORT=8000
BACKEND_BIND=0.0.0.0:8000

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=tuvtk
POSTGRES_USER=tuvtk
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=5432

# Docker
RESTART_POLICY=unless-stopped
