# Project
COMPOSE_PROJECT_NAME=tuvtk_web

# Django container
BACKEND_CONTAINER_NAME=tuvtk_backend
BACKEND_BIND=0.0.0.0:8000
BACKEND_MEMORY_LIMIT=1g
NGINX_MEMORY_LIMIT=128m

# React development container
FRONTEND_CONTAINER_NAME=tuvtk_frontend
FRONTEND_PORT=5173

# Celery and Redis
CELERY_WORKER_CONTAINER_NAME=tuvtk_celery_worker
CELERY_BEAT_CONTAINER_NAME=tuvtk_celery_beat
CELERY_WORKER_MEMORY_LIMIT=1g
CELERY_BEAT_MEMORY_LIMIT=256m
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=info
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DJANGO_CACHE_URL=redis://redis:6379/2
REDIS_CONTAINER_NAME=tuvtk_redis
REDIS_MEMORY_LIMIT=512m
REDIS_VOLUME_NAME=tuvtk_redis_data

# OpenSearch
OPENSEARCH_CONTAINER_NAME=tuvtk_opensearch
OPENSEARCH_MEMORY_LIMIT=1500m
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-this-opensearch-password
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_CA_CERTS=
OPENSEARCH_REQUEST_TIMEOUT=5
OPENSEARCH_FIRME_ONRC_ALIAS=firme-onrc-companies
OPENSEARCH_EXPOSED_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_VOLUME_NAME=tuvtk_opensearch_data

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# Core PostgreSQL container
CORE_DB_CONTAINER_NAME=tuvtk_db_core
CORE_DB_MEMORY_LIMIT=1g
CORE_DB_NAME=tuvtk_core
CORE_DB_USER=tuvtk_core
CORE_DB_PASSWORD=change-this-core-database-password
CORE_DB_HOST=db_core
CORE_DB_PORT=5432
CORE_DB_EXPOSED_PORT=5432
CORE_DB_VOLUME_NAME=tuvtk_core_postgres_data

# Registry PostgreSQL container
REGISTRY_DB_ENABLED=true
REGISTRY_DB_CONTAINER_NAME=tuvtk_db_registry
REGISTRY_DB_MEMORY_LIMIT=1g
REGISTRY_DB_NAME=tuvtk_registry
REGISTRY_DB_USER=tuvtk_registry
REGISTRY_DB_PASSWORD=change-this-registry-database-password
REGISTRY_DB_HOST=db_registry
REGISTRY_DB_PORT=5432
REGISTRY_DB_EXPOSED_PORT=5433
REGISTRY_DB_VOLUME_NAME=tuvtk_registry_postgres_data
ONRC_DATA_DIR=/data/onrc

# Django application
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SETTINGS_MODULE=config.settings
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_WINDOW_SECONDS=300
# Bundled nginx is one trusted hop. Use 2 when an external proxy sits before nginx.
LOGIN_THROTTLE_TRUSTED_PROXY_DEPTH=1

# Development values. Enable secure cookies and HTTPS controls in production.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
