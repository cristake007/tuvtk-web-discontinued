# Production template for the base compose.yaml stack.
# Copy this file to .env and replace every value marked "replace-with".
# Keep .env outside version control and restrict access to its secrets.

# Compose project and container names. Change only when multiple stacks share a host.
COMPOSE_PROJECT_NAME=tuvtk_web
BACKEND_CONTAINER_NAME=tuvtk_backend
NGINX_CONTAINER_NAME=tuvtk_nginx
CELERY_WORKER_CONTAINER_NAME=tuvtk_celery_worker
CELERY_BEAT_CONTAINER_NAME=tuvtk_celery_beat
REDIS_CONTAINER_NAME=tuvtk_redis
CORE_DB_CONTAINER_NAME=tuvtk_db_core
REGISTRY_DB_CONTAINER_NAME=tuvtk_db_registry

# Persistent Docker volumes.
CORE_DB_VOLUME_NAME=tuvtk_core_postgres_data
REGISTRY_DB_VOLUME_NAME=tuvtk_registry_postgres_data
REDIS_VOLUME_NAME=tuvtk_redis_data
STATICFILES_VOLUME_NAME=tuvtk_staticfiles
MEDIA_VOLUME_NAME=tuvtk_media

# Web processes. Terminate HTTPS at a trusted reverse proxy in front of nginx.
BACKEND_BIND=0.0.0.0:8000
NGINX_PORT=80
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# Core PostgreSQL database. Use a unique, randomly generated password.
CORE_DB_NAME=tuvtk_core
CORE_DB_USER=tuvtk_core
CORE_DB_PASSWORD=replace-with-a-random-core-database-password
CORE_DB_HOST=db_core
CORE_DB_PORT=5432

# Registry PostgreSQL database. Disable only when registry data is not required.
REGISTRY_DB_ENABLED=true
REGISTRY_DB_NAME=tuvtk_registry
REGISTRY_DB_USER=tuvtk_registry
REGISTRY_DB_PASSWORD=replace-with-a-random-registry-database-password
REGISTRY_DB_HOST=db_registry
REGISTRY_DB_PORT=5432
ONRC_DATA_DIR=/data/onrc

# Django application. Generate a long, unique secret; never reuse this example value.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# HTTPS security. The reverse proxy must set X-Forwarded-Proto accurately.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# Login throttling.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_WINDOW_SECONDS=300

# Private Redis databases for Celery and Django cache.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DJANGO_CACHE_URL=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=info

# OpenSearch. Keep certificate verification enabled in production.
OPENSEARCH_URL=https://opensearch.example.com:9200
OPENSEARCH_USERNAME=replace-with-opensearch-username
OPENSEARCH_PASSWORD=replace-with-opensearch-password
OPENSEARCH_VERIFY_CERTS=true
# Leave empty to use the system CA bundle, or set an absolute CA certificate path.
OPENSEARCH_CA_CERTS=
OPENSEARCH_REQUEST_TIMEOUT=5
OPENSEARCH_FIRME_ONRC_ALIAS=firme-onrc-companies
