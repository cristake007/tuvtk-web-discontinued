{
  "name": "tuvtk-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run theme:check && tsc -b && vite build",
    "preview": "vite preview",
    "api:types": "node ./scripts/generate-api-types.mjs",
    "shadcn:info": "shadcn info",
    "theme:check": "node ./scripts/check-theme-tokens.mjs",
    "proxy:check": "node ./scripts/check-vite-proxy.mjs",
    "lint": "node ./scripts/check-react-conventions.mjs && npm run proxy:check && eslint . && prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@shadcn/react": "0.2.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.25.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "shadcn": "4.13.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
