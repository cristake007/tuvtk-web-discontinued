create_backend_app() {
    [[ $# -eq 1 ]] || {
        echo "Usage: ./dev backend app <application-name>" >&2
        exit 2
    }

    local app_name="$1"
    local app_host_path="backend/apps/${app_name}"
    local app_container_path="apps/${app_name}"
    local apps_file="${app_host_path}/apps.py"

    if [[ ! "$app_name" =~ ^[a-z][a-z0-9_]*$ ]]; then
        echo "Invalid app name: ${app_name}" >&2
        echo "Use lowercase letters, numbers and underscores." >&2
        exit 1
    fi

    if [[ -e "$app_host_path" ]]; then
        echo "App already exists: ${app_host_path}" >&2
        exit 1
    fi

    mkdir -p backend/apps
    touch backend/apps/__init__.py
    manage startapp "$app_name" "$app_container_path"

    sed -i -E \
        "s|^([[:space:]]*)name = .*$|\1name = \"apps.${app_name}\"|" \
        "$apps_file"

    if ! grep -q "name = \"apps.${app_name}\"" "$apps_file"; then
        echo "Failed to update ${apps_file}" >&2
        exit 1
    fi

    echo "Created Django app: ${app_host_path}"
    echo "Python path: apps.${app_name}"
    echo "Add its complete AppConfig path to INSTALLED_APPS."
}

backend_command() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        app)
            create_backend_app "$@"
            ;;
        manage)
            [[ $# -gt 0 ]] || {
                echo "Usage: ./dev backend manage <arguments>" >&2
                exit 2
            }
            manage "$@"
            ;;
        migrations)
            manage makemigrations "$@"
            ;;
        migrate)
            manage migrate --database=default "$@"
            ;;
        migrate-registry)
            manage migrate --database=registry "$@"
            ;;
        migrate-all)
            manage migrate --database=default
            manage migrate --database=registry
            ;;
        check)
            manage check
            ;;
        lint)
            run_backend ruff check .
            ;;
        schema)
            manage spectacular --validate --file /tmp/tuvtk-openapi.yaml
            ;;
        django-shell)
            manage shell
            ;;
        shell)
            run_backend sh
            ;;
        admin-create)
            manage createsuperuser --database=default
            ;;
        admin-password)
            manage changepassword --database=default "${1:-admin}"
            ;;
        help|-h|--help)
            show_backend_help
            ;;
        *)
            echo "Unknown backend command: ${command}" >&2
            echo >&2
            show_backend_help >&2
            exit 2
            ;;
    esac
}

frontend_command() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        sync|install)
            run_frontend sh ./scripts/sync-dependencies.sh
            ;;
        lock)
            npm install --package-lock-only --include=dev
            echo "Updated frontend/package-lock.json. Review and commit it."
            ;;
        lint)
            npm run lint
            ;;
        typecheck)
            npm run typecheck
            ;;
        test)
            npm run test
            ;;
        build)
            npm run build
            ;;
        npm)
            [[ $# -gt 0 ]] || {
                echo "Usage: ./dev frontend npm <arguments>" >&2
                exit 2
            }
            npm "$@"
            ;;
        shell)
            run_frontend sh
            ;;
        help|-h|--help)
            show_frontend_help
            ;;
        *)
            echo "Unknown frontend command: ${command}" >&2
            echo >&2
            show_frontend_help >&2
            exit 2
            ;;
    esac
}

test_command() {
    local target="${1:-help}"
    shift || true

    case "$target" in
        backend)
            manage test "$@"
            ;;
        frontend)
            [[ $# -eq 0 ]] || {
                echo "Usage: ./dev test frontend" >&2
                exit 2
            }
            npm run test
            ;;
        help|-h|--help)
            show_test_help
            ;;
        *)
            echo "Unknown test target: ${target}" >&2
            echo >&2
            show_test_help >&2
            exit 2
            ;;
    esac
}

database_command() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        reset-core)
            confirm RESET-CORE \
                "This permanently deletes the core database." || {
                echo "Cancelled."
                exit 1
            }

            reset_volume \
                db_core \
                "${CORE_DB_VOLUME_NAME:-tuvtk_core_postgres_data}"

            compose up -d backend
            echo "Core database reset. Run: ./dev backend migrate"
            ;;
        reset-registry)
            confirm RESET-REGISTRY \
                "This permanently deletes the registry database." || {
                echo "Cancelled."
                exit 1
            }

            reset_volume \
                db_registry \
                "${REGISTRY_DB_VOLUME_NAME:-tuvtk_registry_postgres_data}"

            compose up -d backend
            echo "Registry database reset."
            ;;
        reset-all)
            confirm RESET-ALL \
                "This permanently deletes both databases." || {
                echo "Cancelled."
                exit 1
            }

            compose down --remove-orphans

            "${DOCKER[@]}" volume rm \
                "${CORE_DB_VOLUME_NAME:-tuvtk_core_postgres_data}" \
                "${REGISTRY_DB_VOLUME_NAME:-tuvtk_registry_postgres_data}" \
                2>/dev/null || true

            compose up -d --build
            echo "Both databases reset. Run: ./dev backend migrate"
            ;;
        help|-h|--help)
            show_database_help
            ;;
        *)
            echo "Unknown database command: ${command}" >&2
            echo >&2
            show_database_help >&2
            exit 2
            ;;
    esac
}

moved_command() {
    local old_command="$1"
    local replacement="$2"

    echo "Command moved: ./dev ${old_command}" >&2
    echo "Use: ${replacement}" >&2
    exit 2
}

command="${1:-help}"
shift || true

case "$command" in
    up)
        compose up -d --build
        ;;
    down)
        compose down --remove-orphans
        ;;
    restart)
        if [[ $# -gt 0 ]]; then
            compose restart "$@"
        else
            compose restart
        fi
        ;;
    status|ps)
        compose ps
        ;;
    logs)
        compose logs -f --tail=200 "$@"
        ;;
    build)
        compose build "$@"
        ;;
    backend)
        backend_command "$@"
        ;;
    frontend)
        frontend_command "$@"
        ;;
    test)
        test_command "$@"
        ;;
    validate)
        manage check
        run_backend ruff check .
        manage spectacular --validate --file /tmp/tuvtk-openapi.yaml
        manage test
        run_frontend sh ./scripts/sync-dependencies.sh
        npm run lint
        npm run typecheck
        npm run test
        npm run build
        ;;
    database)
        database_command "$@"
        ;;
    wipe)
        confirm WIPE \
            "This removes containers, database volumes and locally built images." || {
            echo "Cancelled."
            exit 1
        }

        compose down \
            --volumes \
            --remove-orphans \
            --rmi local
        ;;
    backend-shell)
        moved_command "backend-shell" "./dev backend shell"
        ;;
    frontend-shell)
        moved_command "frontend-shell" "./dev frontend shell"
        ;;
    django)
        moved_command "django" "./dev backend manage <arguments>"
        ;;
    app)
        moved_command "app" "./dev backend app <name>"
        ;;
    migrations)
        moved_command "migrations" "./dev backend migrations [app]"
        ;;
    migrate)
        moved_command "migrate" "./dev backend migrate [arguments]"
        ;;
    migrate-registry)
        moved_command "migrate-registry" "./dev backend migrate-registry [arguments]"
        ;;
    migrate-all)
        moved_command "migrate-all" "./dev backend migrate-all"
        ;;
    shell)
        moved_command "shell" "./dev backend django-shell"
        ;;
    check)
        moved_command "check" "./dev backend check"
        ;;
    frontend-sync|frontend-install)
        moved_command "$command" "./dev frontend sync"
        ;;
    frontend-lock)
        moved_command "frontend-lock" "./dev frontend lock"
        ;;
    frontend-typecheck)
        moved_command "frontend-typecheck" "./dev frontend typecheck"
        ;;
    frontend-build)
        moved_command "frontend-build" "./dev frontend build"
        ;;
    npm)
        moved_command "npm" "./dev frontend npm <arguments>"
        ;;
    admin-create)
        moved_command "admin-create" "./dev backend admin-create"
        ;;
    admin-password)
        moved_command "admin-password" "./dev backend admin-password [username]"
        ;;
    reset-core-db)
        moved_command "reset-core-db" "./dev database reset-core"
        ;;
    reset-registry-db)
        moved_command "reset-registry-db" "./dev database reset-registry"
        ;;
    reset-db)
        moved_command "reset-db" "./dev database reset-all"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown command or area: ${command}" >&2
        echo >&2
        show_help >&2
        exit 2
        ;;
esac
