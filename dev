#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
fi

export LOCAL_UID="${LOCAL_UID:-$(id -u)}"
export LOCAL_GID="${LOCAL_GID:-$(id -g)}"

if docker info >/dev/null 2>&1; then
    DOCKER=(docker)
else
    DOCKER=(sudo docker)
fi

compose() {
    "${DOCKER[@]}" compose "$@"
}

service_running() {
    local service="$1"

    compose ps --status running --services 2>/dev/null |
        grep -qx "$service"
}

compose_exec() {
    if [[ -t 0 && -t 1 ]]; then
        compose exec "$@"
    else
        compose exec -T "$@"
    fi
}

compose_run() {
    if [[ -t 0 && -t 1 ]]; then
        compose run --rm --no-deps "$@"
    else
        compose run --rm --no-deps -T "$@"
    fi
}

compose_run_with_dependencies() {
    if [[ -t 0 && -t 1 ]]; then
        compose run --rm "$@"
    else
        compose run --rm -T "$@"
    fi
}

run_in_service() {
    local service="$1"
    shift

    if service_running "$service"; then
        compose_exec "$service" "$@"
    else
        compose_run "$service" "$@"
    fi
}

backend() {
    if service_running backend; then
        compose_exec backend "$@"
    else
        compose_run_with_dependencies backend "$@"
    fi
}

frontend() {
    run_in_service frontend "$@"
}

manage() {
    backend python manage.py "$@"
}

npm() {
    frontend npm "$@"
}

confirm() {
    local expected="$1"
    local message="$2"
    local response=""

    echo "$message"
    read -r -p "Type ${expected} to continue: " response
    [[ "$response" == "$expected" ]]
}

wait_for_database() {
    local service="$1"

    echo "Waiting for ${service}..."

    until compose_exec "$service" pg_isready >/dev/null 2>&1; do
        sleep 1
    done
}

reset_volume() {
    local service="$1"
    local volume="$2"

    compose stop backend "$service" 2>/dev/null || true
    compose rm -f "$service" 2>/dev/null || true

    if "${DOCKER[@]}" volume inspect "$volume" >/dev/null 2>&1; then
        "${DOCKER[@]}" volume rm "$volume"
    fi

    compose up -d "$service"
    wait_for_database "$service"
}

show_help() {
    cat <<'HELP'
Usage: ./dev <command> [arguments]

Containers:
  up                         Build and start the development environment
  down                       Stop and remove containers
  restart [service]          Restart everything or one service
  status                     Show container status
  logs [service]             Follow container logs
  build [service]            Rebuild images
  backend-shell              Open /bin/sh in the Django container
  frontend-shell             Open /bin/sh in the React container

Django:
  django <arguments>         Run any manage.py command
  app <name>                 Create an app under backend/apps/
  migrations [app]           Create migration files
  migrate                    Migrate the core/default database
  migrate-registry           Migrate the registry database
  migrate-all                Migrate both databases
  shell                      Open the Django shell
  check                      Run Django system checks
  test [arguments]           Run Django tests

Frontend:
  frontend-sync              Sync node_modules from package-lock.json
  frontend-lock              Create or refresh package-lock.json
  frontend-install           Alias for frontend-sync
  frontend-typecheck         Run TypeScript validation
  frontend-build             Build the React application
  npm <arguments>            Run any npm command in the frontend container

Validation:
  validate                   Run Django checks/tests and frontend checks/build

Administration:
  admin-create               Create a core database administrator
  admin-password [username]  Reset an administrator password

Database:
  reset-core-db              Delete only the core database volume
  reset-registry-db          Delete only the registry database volume
  reset-db                   Delete both database volumes

Destructive:
  wipe                       Remove containers, volumes and local images

Destructive commands never delete backend/, frontend/, source files, or .env.
HELP
}

command="${1:-help}"
shift || true

case "$command" in
    up)
        compose up -d --build
        ;;

    down)
        compose down --remove-orphans
        ;;

    restart)
        if [[ $# -gt 0 ]]; then
            compose restart "$@"
        else
            compose restart
        fi
        ;;

    status|ps)
        compose ps
        ;;

    logs)
        compose logs -f --tail=200 "$@"
        ;;

    build)
        compose build "$@"
        ;;

    backend-shell)
        backend sh
        ;;

    frontend-shell)
        frontend sh
        ;;

    django)
        manage "$@"
        ;;

    app)
        [[ $# -eq 1 ]] || {
            echo "Usage: ./dev app <application-name>" >&2
            exit 2
        }

        app_name="$1"
        app_host_path="backend/apps/${app_name}"
        app_container_path="apps/${app_name}"

        if [[ ! "$app_name" =~ ^[a-z][a-z0-9_]*$ ]]; then
            echo "Invalid app name: ${app_name}" >&2
            echo "Use lowercase letters, numbers and underscores." >&2
            exit 1
        fi

        if [[ -e "$app_host_path" ]]; then
            echo "App already exists: ${app_host_path}" >&2
            exit 1
        fi

        mkdir -p backend/apps
        touch backend/apps/__init__.py

        manage startapp "$app_name" "$app_container_path"

        apps_file="${app_host_path}/apps.py"
        sed -i -E \
            "s|^([[:space:]]*)name = .*$|\1name = \"apps.${app_name}\"|" \
            "$apps_file"

        if ! grep -q "name = \"apps.${app_name}\"" "$apps_file"; then
            echo "Failed to update ${apps_file}" >&2
            exit 1
        fi

        echo "Created Django app: ${app_host_path}"
        echo "Python path: apps.${app_name}"
        echo "Add its complete AppConfig path to INSTALLED_APPS."
        ;;

    migrations)
        manage makemigrations "$@"
        ;;

    migrate)
        manage migrate --database=default "$@"
        ;;

    migrate-registry)
        manage migrate --database=registry "$@"
        ;;

    migrate-all)
        manage migrate --database=default
        manage migrate --database=registry
        ;;

    shell)
        manage shell
        ;;

    check)
        manage check
        ;;

    test)
        manage test "$@"
        ;;

    frontend-sync|frontend-install)
        frontend sh ./scripts/sync-dependencies.sh
        ;;

    frontend-lock)
        npm install --package-lock-only --include=dev
        echo "Updated frontend/package-lock.json. Review and commit it."
        ;;

    frontend-typecheck)
        npm run typecheck
        ;;

    frontend-build)
        npm run build
        ;;

    npm)
        npm "$@"
        ;;

    validate)
        manage check
        manage test
        frontend sh ./scripts/sync-dependencies.sh
        npm run typecheck
        npm run build
        ;;

    admin-create)
        manage createsuperuser --database=default
        ;;

    admin-password)
        manage changepassword --database=default "${1:-admin}"
        ;;

    reset-core-db)
        confirm RESET-CORE \
            "This permanently deletes the core database." || {
            echo "Cancelled."
            exit 1
        }

        reset_volume \
            db_core \
            "${CORE_DB_VOLUME_NAME:-tuvtk_core_postgres_data}"

        compose up -d backend
        echo "Core database reset. Run: ./dev migrate"
        ;;

    reset-registry-db)
        confirm RESET-REGISTRY \
            "This permanently deletes the registry database." || {
            echo "Cancelled."
            exit 1
        }

        reset_volume \
            db_registry \
            "${REGISTRY_DB_VOLUME_NAME:-tuvtk_registry_postgres_data}"

        compose up -d backend
        echo "Registry database reset."
        ;;

    reset-db)
        confirm RESET-ALL \
            "This permanently deletes both databases." || {
            echo "Cancelled."
            exit 1
        }

        compose down --remove-orphans

        "${DOCKER[@]}" volume rm \
            "${CORE_DB_VOLUME_NAME:-tuvtk_core_postgres_data}" \
            "${REGISTRY_DB_VOLUME_NAME:-tuvtk_registry_postgres_data}" \
            2>/dev/null || true

        compose up -d --build
        echo "Both databases reset. Run: ./dev migrate"
        ;;

    wipe)
        confirm WIPE \
            "This removes containers, database volumes and locally built images." || {
            echo "Cancelled."
            exit 1
        }

        compose down \
            --volumes \
            --remove-orphans \
            --rmi local
        ;;

    help|-h|--help)
        show_help
        ;;

    *)
        echo "Unknown command: ${command}" >&2
        echo
        show_help
        exit 2
        ;;
esac
