#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
fi

export LOCAL_UID="${LOCAL_UID:-$(id -u)}"
export LOCAL_GID="${LOCAL_GID:-$(id -g)}"

if docker info >/dev/null 2>&1; then
    DOCKER=(docker)
else
    DOCKER=(sudo docker)
fi

compose() {
    "${DOCKER[@]}" compose "$@"
}

service_running() {
    local service="$1"

    compose ps --status running --services 2>/dev/null |
        grep -qx "$service"
}

compose_exec() {
    if [[ -t 0 && -t 1 ]]; then
        compose exec "$@"
    else
        compose exec -T "$@"
    fi
}

compose_run() {
    if [[ -t 0 && -t 1 ]]; then
        compose run --rm --no-deps "$@"
    else
        compose run --rm --no-deps -T "$@"
    fi
}

compose_run_with_dependencies() {
    if [[ -t 0 && -t 1 ]]; then
        compose run --rm "$@"
    else
        compose run --rm -T "$@"
    fi
}

run_in_service() {
    local service="$1"
    shift

    if service_running "$service"; then
        compose_exec "$service" "$@"
    else
        compose_run "$service" "$@"
    fi
}

run_backend() {
    if service_running backend; then
        compose_exec backend "$@"
    else
        compose_run_with_dependencies backend "$@"
    fi
}

run_frontend() {
    run_in_service frontend "$@"
}

manage() {
    run_backend python manage.py "$@"
}

npm() {
    run_frontend npm "$@"
}

confirm() {
    local expected="$1"
    local message="$2"
    local response=""

    echo "$message"
    read -r -p "Type ${expected} to continue: " response
    [[ "$response" == "$expected" ]]
}

wait_for_database() {
    local service="$1"

    echo "Waiting for ${service}..."
    until compose_exec "$service" pg_isready >/dev/null 2>&1; do
        sleep 1
    done
}

reset_volume() {
    local service="$1"
    local volume="$2"

    compose stop backend "$service" 2>/dev/null || true
    compose rm -f "$service" 2>/dev/null || true

    if "${DOCKER[@]}" volume inspect "$volume" >/dev/null 2>&1; then
        "${DOCKER[@]}" volume rm "$volume"
    fi

    compose up -d "$service"
    wait_for_database "$service"
}

